# ===========================
# Vertex AI Configuration (Backend API)
# ===========================
# Get these from Google Cloud Console (https://console.cloud.google.com/)
# Your Google Developer Program credits work here!
VERTEX_AI_PROJECT_ID=your-google-cloud-project-id
VERTEX_AI_LOCATION=us-central1
# For local development, you can paste the entire service account JSON here
# Or use: gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# API endpoint (automatically set by Vercel, leave as-is for local dev)
VITE_API_URL=http://localhost:5173

# Google Calendar API Configuration
# Get these from Google Cloud Console (https://console.cloud.google.com/)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_API_KEY=your_google_api_key_here

# Microsoft Graph API Configuration (Outlook/Teams Calendar)
# Get these from Azure Portal (https://portal.azure.com/) > App Registrations
# 1. Register a new app (Single Page Application)
# 2. Add Redirect URI: http://localhost:3000 (or your app URL)
# 3. In "Authentication", enable "Access tokens" and "ID tokens" (Implicit/Hybrid flow)
VITE_MICROSOFT_CLIENT_ID=your_microsoft_client_id_here

# Optional: Tenant ID (Use 'common' for personal/multi-tenant, or your specific Org ID)
# If you are asking for "OAuth ID", this is likely the Tenant ID.
VITE_MICROSOFT_TENANT_ID=common

# ===========================
# Supabase Configuration (Database)
# ===========================
# Get these from your Supabase Dashboard (https://supabase.com/dashboard)
# 1. Go to your project
# 2. Click "Settings" → "API"
# 3. Copy "Project URL" and "anon public" key
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
