# Gemini API Key (Required for AI Chat)
API_KEY=your_gemini_api_key_here

# Google Calendar API Configuration
# Get these from Google Cloud Console (https://console.cloud.google.com/)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here
REACT_APP_GOOGLE_API_KEY=your_google_api_key_here

# Microsoft Graph API Configuration (Outlook/Teams Calendar)
# Get these from Azure Portal (https://portal.azure.com/) > App Registrations
# 1. Register a new app (Single Page Application)
# 2. Add Redirect URI: http://localhost:3000 (or your app URL)
# 3. In "Authentication", enable "Access tokens" and "ID tokens" (Implicit/Hybrid flow)
REACT_APP_MICROSOFT_CLIENT_ID=your_microsoft_client_id_here

# Optional: Tenant ID (Use 'common' for personal/multi-tenant, or your specific Org ID)
# If you are asking for "OAuth ID", this is likely the Tenant ID.
REACT_APP_MICROSOFT_TENANT_ID=common
